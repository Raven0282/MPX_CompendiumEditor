<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CompendiumEditor.ViewModels"
        xmlns:controls="using:CompendiumEditor.Controls"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
		x:Class="CompendiumEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MasterplanXP - 4e Compendium Editor"
		Icon="/Assets/Images/logo-small-icon.ico"
        Width="1400" Height="850"
		MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto, *">

	<Border Grid.Row="0" Background="{DynamicResource SystemChromeLowColor}" Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}">
			<Grid ColumnDefinitions="Auto, *, Auto">

				<!-- Zone 1: Left Actions (Fixed) -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<Button Content="Select Folder"
                            Command="{Binding SelectRepositoryFolderCommand}"
                            Background="{DynamicResource SystemAccentColor}"
                            Foreground="White"/>
					
					<Button Content="➕ New Record"
                            Command="{Binding AppendNewRecordCommand}"
							IsVisible="{Binding !IsAppendMode}"
                            Background="{DynamicResource SystemListLowColor}"
                            VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Zone 2: Centered Metadata (Fluid but non-shifting) -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="{Binding DisplayRepositoryPath}"
							   VerticalAlignment="Center"
							   FontStyle="Italic"
							   Opacity="0.7"
							   TextTrimming="CharacterEllipsis"
							   MaxWidth="450"/>

					<Border Background="{DynamicResource SystemAccentColor}" 
							CornerRadius="12" 
							Padding="8,2" 
							IsVisible="{Binding IsDataLoaded}"
							VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="{Binding RecordCount}" 
									   Foreground="White" 
									   FontWeight="Bold" 
									   FontSize="12"/>
							<TextBlock Text="Records" 
									   Foreground="White" 
									   FontSize="11" 
									   VerticalAlignment="Center"
									   Opacity="0.9"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- Zone 3: Right Actions & Toggles (Pinned Right) -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="0,0,10,0">
					<Panel>
						<Button Content="💾 Save Changes"
								Command="{Binding SaveChangesCommand}"
								IsVisible="{Binding !IsAppendMode}"
								Background="ForestGreen"
								Foreground="White"
								FontWeight="SemiBold"
								VerticalAlignment="Center"/>

						<Button Content="✨ Commit New"
								Command="{Binding CommitNewRecordCommand}"
								IsVisible="{Binding IsAppendMode}"
								Background="DarkOrange"
								Foreground="White"
								FontWeight="SemiBold"
								VerticalAlignment="Center"/>
					</Panel>
					
					<ToggleSwitch IsChecked="{Binding IsClassicViewEnabled}"
                                  OnContent="Classic View (HTML)"
                                  OffContent="Modern View (Native)"
                                  VerticalAlignment="Center"/>

					<ToggleSwitch IsChecked="{Binding IsDarkMode}"
                                  OnContent="Dark"
                                  OffContent="Light"
                                  VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

	<Grid Grid.Row="1" ColumnDefinitions="400, 5, *, 5, *">
			<Panel Grid.Column="0" Grid.ColumnSpan="5" ZIndex="100"
                   Background="#AA000000"
                   IsVisible="{Binding ShowValidationErrorAlert}">
				<Border Background="{DynamicResource SystemChromeMediumColor}"
                        CornerRadius="8" Padding="25"
                        Width="550" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="Crimson">
					<StackPanel Spacing="15">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="⚠️" FontSize="24" VerticalAlignment="Center"/>
							<TextBlock Text="Compendium HTML Serialization Error" FontSize="18" FontWeight="Bold" Foreground="Crimson" VerticalAlignment="Center"/>
						</StackPanel>

						<TextBlock Text="{Binding ValidationErrorMessage}" TextWrapping="Wrap" FontSize="14" Opacity="0.9"/>
						<TextBlock Text="How do you wish to proceed with this transactional data block record context?" FontStyle="Italic" FontSize="12" Opacity="0.7"/>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,15,0,0">
							<Button Content="Go Back &amp; Correct Markup"
                                    Command="{Binding DismissAlertAndKeepEditingCommand}"
                                    Padding="10,6" VerticalAlignment="Center"/>

							<Button Content="Discard Edits &amp; Revert to Backup"
                                    Command="{Binding RollbackToBackupCommand}"
                                    Background="Crimson" Foreground="White"
                                    Padding="10,6" VerticalAlignment="Center"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Panel>

			<Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="10">
				<TextBox Grid.Row="0"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
						 PlaceholderText="Search elements by ID or text string..."
                         Margin="0,0,0,10"/>

				<DataGrid Grid.Row="1" Name="RecordsDataGrid"
                          ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
						  CanUserResizeColumns="True"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlTransientBorderBrush}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" FontFamily="Consolas,JetBrains Mono,Courier New" FontSize="12" />
						<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" FontFamily="Consolas,JetBrains Mono,Courier New" FontSize="12"  />
						<DataGridTextColumn Header="Source" Binding="{Binding SourceBook}" Width="Auto" FontFamily="Consolas,JetBrains Mono,Courier New" FontSize="12"  />
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<GridSplitter Grid.Column="1" Background="Transparent"/>

			<Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" Margin="5,10">
				<Grid RowDefinitions="Auto, *">
					<Border Grid.Row="0" Background="{DynamicResource SystemListLowColor}" Padding="6">
						<TextBlock Text="RAW Source Markup Editor" HorizontalAlignment="Center" FontWeight="SemiBold"/>
					</Border>
					<ae:TextEditor Grid.Row="1" Name="MarkupDocumentEditor"
                                   Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                   FontFamily="Consolas,JetBrains Mono,Courier New"
                                   FontSize="14"
                                   ShowLineNumbers="True"
                                   WordWrap="True"
                                   HorizontalScrollBarVisibility="Disabled"
                                   VerticalScrollBarVisibility="Visible"/>
				</Grid>
			</Border>

			<GridSplitter Grid.Column="3" Background="Transparent"/>

			<Border Grid.Column="4" BorderThickness="1" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" Margin="5,10,10,10">
				<Grid RowDefinitions="Auto, *">
					<Border Grid.Row="0" Background="{DynamicResource SystemListLowColor}" Padding="6">
						<TextBlock Text="Output Display Preview" HorizontalAlignment="Center" FontWeight="SemiBold"/>
					</Border>

					<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">						
						<Panel Margin="15">
							<controls:NativeHtmlPreviewer
                                HtmlSource="{Binding RawHtmlContent}"
                                TextWrapping="Wrap"
								VerticalAlignment="Top"
                                IsVisible="{Binding !IsClassicViewEnabled}"/>

							<controls:ClassicHtmlPreviewer
								HtmlSource="{Binding RawHtmlContent}"
								CssStyles="{Binding InjectedStyles}"
								VerticalAlignment="Top"
								IsVisible="{Binding IsClassicViewEnabled}"/>
						</Panel>
					</ScrollViewer>
				</Grid>
			</Border>

		</Grid>
	</Grid>
</Window>