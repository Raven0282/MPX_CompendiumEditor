<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:CompendiumEditor.Views"
        xmlns:vm="using:CompendiumEditor.ViewModels"
        x:Class="CompendiumEditor.Views.PopOutEditorWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Compendium Editor - MPX Pop-out"
        Icon="/Assets/Images/logo-small-icon.ico"
        Width="800" Height="900"
        WindowStartupLocation="CenterOwner">
    
    <views:RawEditorView/>
</Window>
