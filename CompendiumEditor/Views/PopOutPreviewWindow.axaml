<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:CompendiumEditor.Views"
        xmlns:vm="using:CompendiumEditor.ViewModels"
        x:Class="CompendiumEditor.Views.PopOutPreviewWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Compendium Preview - MPX Pop-out"
        Icon="/Assets/Images/logo-small-icon.ico"
        Width="600" Height="800"
        WindowStartupLocation="CenterOwner">
    
    <views:CompendiumPreviewView/>
</Window>
